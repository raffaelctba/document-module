# document-service prod environment template.
# CI writes this file to /opt/prd/document/.env on every deploy. Never commit real values.

# Set by CI
IMAGE_TAG=latest
GHCR_OWNER=raffaelctba
MODULE_NETWORK=mybuilding-prd

# [secret, REQUIRED] JDBC URL of the shared Postgres (same DB as pm-backend), e.g. jdbc:postgresql://<host>:5432/<db>
DATABASE_URL=
# [secret, REQUIRED] Recommended: a dedicated role with DML-only grants on the module schema (DDL stays with the host Flyway)
DATABASE_USERNAME=
# [secret, REQUIRED]
DATABASE_PASSWORD=
# [secret, REQUIRED] HMAC shared with api-gateway (same per-env value)
GATEWAY_INTERNAL_SECRET=
# [var, REQUIRED] Shared Redis (same host as otp-service). platform-messaging + health need it
REDIS_HOST=
# [var]
REDIS_PORT=6379
# [secret, REQUIRED] Same as otp-service REDIS_PASSWORD
REDIS_PASSWORD=
# [var] Dedicated Redis logical DB. platform-messaging uses Redis Streams consumer groups; sharing pm-backend's DB would make this idle service COMPETE for host messages. Change only at HTTP cutover
REDIS_DATABASE=12
# [var, REQUIRED] s3 | filesystem | memory — must match pm-backend's store
DOCUMENTS_STORAGE_PROVIDER=
# [var]
DOCUMENTS_BUCKET=
# [var]
DOCUMENTS_KEY_PREFIX=
# [var]
DOCUMENTS_S3_REGION=
# [var] optional (non-AWS S3)
DOCUMENTS_S3_ENDPOINT=
# [secret]
DOCUMENTS_S3_ACCESS_KEY=
# [secret]
DOCUMENTS_S3_SECRET_KEY=

JAVA_OPTS=-Xms128m -Xmx384m
